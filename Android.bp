soong_namespace {
}

vintf_compatibility_matrix {
    name: "framework_compatibility_matrix.kernel.xml",
    stem: "compatibility_matrix.kernel.xml",
    srcs: ["vintf/compatibility_matrix.kernel.xml"],
}

vintf_compatibility_matrix {
    name: "framework_compatibility_matrix.6.xml",
    stem: "compatibility_matrix.6.xml",
    srcs: ["vintf/compatibility_matrix.6.xml"],
