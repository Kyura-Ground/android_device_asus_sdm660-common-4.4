on init
    # Notification LED
    chown system system /sys/class/leds/red/blink
    chown system system /sys/class/leds/red/brightness
    chown system system /sys/class/leds/green/blink
    chown system system /sys/class/leds/green/brightness

    chmod 0664 /sys/class/leds/red/blink
    chmod 0644 /sys/class/leds/red/brightness
    chmod 0664 /sys/class/leds/green/blink
    chmod 0644 /sys/class/leds/green/brightness

    # LCD backlight
    chown system system /sys/class/leds/lcd-backlight/brightness

service vendor.light-hal /vendor/bin/hw/android.hardware.light-service.asus_sdm660
    interface aidl android.hardware.light.ILights/default
    class hal
    user system
    group system
    # shutting off lights while powering-off
    shutdown critical
    task_profiles ServiceCapacityLow
