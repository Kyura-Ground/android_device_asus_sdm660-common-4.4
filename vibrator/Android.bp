cc_binary {
    name: "android.hardware.vibrator-service.asus_sdm660",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator-service.asus_sdm660.rc"],
    vintf_fragments: ["android.hardware.vibrator-service.asus_sdm660.xml"],
    srcs: ["service.cpp"],
    shared_libs: [
        "android.hardware.vibrator-V2-ndk",
        "libbase",
        "libbinder_ndk",
        "vendor.qti.hardware.vibrator.impl",
    ],
    cpp_std: "c++17",
    cflags: ["-Wall", "-Wextra", "-Werror"],
    overrides: ["vendor.qti.hardware.vibrator.service"],
}
