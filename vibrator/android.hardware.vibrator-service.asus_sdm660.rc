on post-fs-data
    chown system system /sys/class/leds/vibrator/amplitude
    chmod 0660 /sys/class/leds/vibrator/amplitude

service vendor.asus.vibrator /vendor/bin/hw/android.hardware.vibrator-service.asus_sdm660
    class hal
    user system
    group system input

on late-init
    write /sys/class/leds/vibrator/trigger "transient"
